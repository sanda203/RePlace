# PostgreSQL
POSTGRES_DB=reservation_api
POSTGRES_USER=replace
POSTGRES_PASSWORD=replace

# JWT signing secret (HS256 requires at least 32 characters)
JWT_SECRET=local-dev-secret-change-me-0123456789abcdef

# First admin account, created on startup if it does not exist
ADMIN_EMAIL=admin@replace.dev
ADMIN_PASSWORD=admin
